# Text is stored and checked out with LF on every platform (AIKit, ADR-436, ADR-454).
* text=auto eol=lf
# cmd.exe needs CRLF in its own scripts.
*.bat text eol=crlf
*.cmd text eol=crlf
# Never converted, whatever their bytes look like.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp3 binary
*.wav binary
*.ogg binary
*.mp4 binary
